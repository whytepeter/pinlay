// Prisma schema — pinlay v1
// ─────────────────────────
// Models match the extension's API contract (apps/extension/src/lib/api.ts)
// and the shared enums (packages/shared/src/enums.ts). Pin grouping:
//   Session (a single review sitting) → Issue (titled group of pins) → Pin.
// Pins exist standalone first (issue == null while drafting); the session is
// finalised by titling the Issue on "Done".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (mirror packages/shared/src/enums.ts) ─────────────────────────────
enum Severity {
  critical
  high
  medium
  low
}

enum Status {
  open
  in_progress
  resolved
  draft
  archived
}

enum PinType {
  visual
  layout
  copy
  broken
  missing
  a11y
  perf
  other
}

enum Role {
  owner
  admin
  member
  viewer
}

enum AttachmentType {
  screenshot
  thumbnail
  export
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

// ── Identity ────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  avatarUrl    String?
  // Null for users created via the dev seed or OAuth-only flows. Required
  // for email/password auth — checked in AuthService.login.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    WorkspaceMember[]
  authoredPins   Pin[]             @relation("PinAuthor")
  assignedPins   Pin[]             @relation("PinAssignee")
  authoredIssues Issue[]           @relation("IssueAuthor")
  sentInvites    Invite[]          @relation("InviteAuthor")
  pinComments    PinComment[]      @relation("PinCommentAuthor")
  feedback       Feedback[]        @relation("FeedbackAuthor")
}

model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  issues   Issue[]
  sessions Session[]
  boards   Board[]
  invites  Invite[]
}

/**
 * Pending workspace invite. Created when an admin invites an email that
 * doesn't yet correspond to a pinlay account. On signup with a matching
 * email, AuthService converts pending invites → WorkspaceMember rows.
 * A short opaque `token` powers a future accept-by-link flow (when email is
 * wired); for now its uniqueness lets resend regenerate without colliding.
 * Uniqueness: at most one PENDING invite per (workspaceId, email). Accepted
 * + revoked rows are retained for audit so re-inviting after a revoke
 * creates a new pending row alongside the historic one.
 */
model Invite {
  id          String       @id @default(cuid())
  workspaceId String
  email       String
  role        Role         @default(member)
  status      InviteStatus @default(pending)
  token       String       @unique
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InviteAuthor", fields: [invitedById], references: [id])

  // Partial unique index emulated in app code (Prisma doesn't expose
  // partial uniques directly): we check before insert. The plain index
  // accelerates the workspace+email lookup the check uses.
  @@index([workspaceId, email])
  @@index([workspaceId, status])
}

/**
 * A Board groups related issues — typically by feature area ("Checkout",
 * "Marketing site"). Boards are workspace-scoped; the same slug can recur
 * across tenants. `position` is a sparse integer order so reorders only
 * touch the dragged row (no full-list rewrite). Color is a hex string so
 * downstream renderers can paint a dot without a token lookup.
 */
model Board {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  color       String   @default("#7c3aed")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, position])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(member)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ── Annotation flow ─────────────────────────────────────────────────────────
// A Session is one review sitting (opened when the user enters annotation,
// closed when they hit Done). The Issue groups the session's pins under a
// single title. Pins can exist before an Issue is created (draft state).
model Session {
  id          String    @id @default(cuid())
  workspaceId String
  authorId    String
  pageUrl     String
  status      Status    @default(draft)
  startedAt   DateTime  @default(now())
  closedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pins      Pin[]
  issue     Issue?

  @@index([workspaceId])
  @@index([pageUrl])
}

model Issue {
  id          String   @id @default(cuid())
  // Human-friendly sequential number, rendered as "PL-0142" in the dashboard.
  // Global autoincrement (not per-workspace) — simplest stable short id; the
  // workspace scope is enforced on every read so cross-tenant ids never leak.
  seq         Int      @unique @default(autoincrement())
  workspaceId String
  sessionId   String   @unique
  authorId    String
  // Optional grouping. SetNull on board delete so issues stay reachable
  // (board deletion isn't a destructive op for the issues themselves).
  boardId     String?
  title       String
  summary     String?
  pageUrl     String
  status      Status   @default(open)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author      User         @relation("IssueAuthor", fields: [authorId], references: [id])
  board       Board?       @relation(fields: [boardId], references: [id], onDelete: SetNull)
  pins        Pin[]
  attachments Attachment[]

  @@index([workspaceId])
  @@index([pageUrl])
  @@index([boardId])
}

model Pin {
  id         String   @id @default(cuid())
  sessionId  String
  issueId    String?
  authorId   String
  assigneeId String?
  index      Int
  pageUrl    String
  anchor     Json
  offsetX    Float
  offsetY    Float
  comment    String
  severity   Severity
  issueType  PinType  @default(other)
  status     Status   @default(open)
  labels     String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  issue       Issue?       @relation(fields: [issueId], references: [id], onDelete: SetNull)
  author      User         @relation("PinAuthor", fields: [authorId], references: [id])
  assignee    User?        @relation("PinAssignee", fields: [assigneeId], references: [id])
  attachments Attachment[]
  comments    PinComment[]

  @@index([sessionId])
  @@index([issueId])
  @@index([pageUrl])
}

/**
 * Threaded discussion attached to a single pin. Workspace scoping is
 * inherited transitively (pin → session → workspace) — comments don't carry
 * a workspaceId of their own. Cascade on pin delete; restrict on author
 * delete (preserve discussion history).
 */
model PinComment {
  id        String   @id @default(cuid())
  pinId     String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pin    Pin  @relation(fields: [pinId], references: [id], onDelete: Cascade)
  author User @relation("PinCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([pinId])
}

// ── Attachments ─────────────────────────────────────────────────────────────
// `url` stores the storage URL (S3/R2) once the upload service lands; v1
// keeps dataUrl strings inline for fast local iteration.
model Attachment {
  id          String         @id @default(cuid())
  pinId       String?
  issueId     String?
  type        AttachmentType @default(screenshot)
  filename    String
  contentType String
  url         String
  sizeBytes   Int
  width       Int?
  height      Int?
  createdAt   DateTime       @default(now())

  pin   Pin?   @relation(fields: [pinId], references: [id], onDelete: Cascade)
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([pinId])
  @@index([issueId])
}

// ── Product feedback ────────────────────────────────────────────────────────
// In-app feedback about pinlay itself (not pins — those are feedback about a
// *customer's* site). Rows are written first and the notification email is
// fired best-effort afterwards, so a mail outage can never lose a submission.
// Deliberately NOT workspace-scoped: this is a message to the pinlay team, and
// keeping it outside workspace reads means no member can browse others' notes.
enum FeedbackKind {
  bug
  idea
  question
  other
}

model Feedback {
  id      String       @id @default(cuid())
  kind    FeedbackKind @default(other)
  message String

  // Denormalised on purpose: if the user later deletes their account we still
  // want the report readable, and `userId` goes null rather than cascading the
  // row away.
  userId      String?
  email       String?
  name        String?
  workspaceId String?

  // Context captured client-side — which page they were on and what browser.
  // Makes a vague "it's broken" actionable without a follow-up round trip.
  path      String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}
