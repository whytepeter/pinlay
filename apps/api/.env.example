# ── pinlay api ───────────────────────────────────────────────────────────────
# Copy to .env and fill in. `.env` is git-ignored.

# Neon Postgres connection string. Grab it from:
#   Neon dashboard → Project → Connection details → "Pooled connection"
# The pooled URL (port 5432 via pgbouncer) is what Prisma wants for queries.
# For migrations you can use the "Direct connection" URL or the same pooled
# one — Prisma handles either.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/pinlay?sslmode=require"

# Optional: direct (non-pooled) URL for shadow DBs + migrations.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/pinlay?sslmode=require"

PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins. The extension's
# chrome-extension://<id> origin gets allowed automatically.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Symmetric secret used to sign JWTs. Generate one with:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64"))'
# Rotating this invalidates every issued token.
JWT_SECRET="change-me-with-a-real-random-string-at-least-32-bytes-long"
JWT_EXPIRES_IN="30d"

# ── Limits ───────────────────────────────────────────────────────────────────
# Max request body size. Kept low now that attachments upload via presigned
# URLs — only DTO payloads flow through the Nest process.
BODY_LIMIT="1mb"

# ── Object storage — Cloudflare R2 (attachments + avatars) ─────────────
# All fields required. The API refuses to boot if any are missing.
#
# How to get these:
#   1. Cloudflare dashboard → R2 → Create bucket (e.g. `pinlay-uploads`)
#   2. R2 → Manage API tokens → Create Token (Object Read+Write scope)
#      → gives you Access Key ID + Secret Access Key + Account Endpoint
#   3. In the bucket settings, enable "Public access" (r2.dev subdomain)
#      OR add a custom domain, then paste that as STORAGE_PUBLIC_URL_BASE
#   4. Bucket → Settings → CORS: allow PUT + Content-Type header from
#      your web origin and `chrome-extension://*`
STORAGE_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
STORAGE_BUCKET="pinlay-uploads"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY="<r2-access-key-id>"
STORAGE_SECRET_KEY="<r2-secret-access-key>"
# No trailing slash.
STORAGE_PUBLIC_URL_BASE="https://pub-<hash>.r2.dev"

# 20 MB per object. Presign refuses anything larger.
STORAGE_MAX_UPLOAD_BYTES=20971520
