# ── pinlay api ───────────────────────────────────────────────────────────────
# Copy to .env and fill in. `.env` is git-ignored.

# Neon Postgres connection string. Grab it from:
#   Neon dashboard → Project → Connection details → "Pooled connection"
# The pooled URL (port 5432 via pgbouncer) is what Prisma wants for queries.
# For migrations you can use the "Direct connection" URL or the same pooled
# one — Prisma handles either.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/pinlay?sslmode=require"

# Optional: direct (non-pooled) URL for shadow DBs + migrations.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/pinlay?sslmode=require"

# Railway injects PORT automatically at runtime — do NOT hard-code it in the
# Railway service variables. Locally, 4000 is the fallback (dev runs on 8787
# via the .env below).
PORT=4000
# Set NODE_ENV=production in the Railway service variables. In production the
# env validator (src/config/env.ts) fails fast if JWT_SECRET < 32 chars or
# CORS_ORIGINS is empty, so a misconfigured deploy never boots insecure.
NODE_ENV=development

# CORS — comma-separated list of allowed origins. The extension's
# chrome-extension://<id> origin gets allowed automatically.
#   - Production: set to the deployed dashboard origin(s), e.g.
#       CORS_ORIGINS="https://app.pinlay.app,https://pinlay.vercel.app"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Symmetric secret used to sign JWTs. Generate one with:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64"))'
# Rotating this invalidates every issued token.
JWT_SECRET="change-me-with-a-real-random-string-at-least-32-bytes-long"
JWT_EXPIRES_IN="30d"

# ── Dashboard URL ────────────────────────────────────────────────────────────
# Public origin of the deployed web app. Used to mint invite-accept links.
# No trailing slash. In production set to the Vercel URL, e.g.
#   WEB_APP_URL="https://app.pinlay.app"
WEB_APP_URL="http://localhost:5173"

# ── Transactional email (invites) ────────────────────────────────────────────
# `disabled` (default) logs the payload instead of sending — fine for dev, and
# usable in prod if admins copy invite links manually (the API warns loudly).
# Set to `resend` + provide a key to actually send.
MAIL_PROVIDER="disabled"
# MAIL_API_KEY="re_..."
MAIL_FROM="pinlay <onboarding@resend.dev>"

# Where in-app feedback (POST /api/feedback) is emailed. Falls back to the
# address inside MAIL_FROM when unset.
#
# NOTE: until a sending domain is verified in Resend, the `onboarding@resend.dev`
# sender can ONLY deliver to the Resend account owner's own address — every
# other recipient is rejected with a 403. Feedback notifications happen to be
# the one flow that still works under that limit (they're addressed to you);
# workspace INVITES to teammates will silently fail until a domain is verified.
# MAIL_FEEDBACK_TO="you@example.com"

# ── Limits ───────────────────────────────────────────────────────────────────
# Max request body size. Kept low now that attachments upload via presigned
# URLs — only DTO payloads flow through the Nest process.
BODY_LIMIT="1mb"

# ── Object storage — Cloudflare R2 (attachments + avatars) ─────────────
# All fields required. The API refuses to boot if any are missing.
#
# How to get these:
#   1. Cloudflare dashboard → R2 → Create bucket (e.g. `pinlay-uploads`)
#   2. R2 → Manage API tokens → Create Token (Object Read+Write scope)
#      → gives you Access Key ID + Secret Access Key + Account Endpoint
#   3. In the bucket settings, enable "Public access" (r2.dev subdomain)
#      OR add a custom domain, then paste that as STORAGE_PUBLIC_URL_BASE
#   4. Bucket → Settings → CORS: allow PUT + Content-Type header from
#      your web origin and `chrome-extension://*`
STORAGE_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
STORAGE_BUCKET="pinlay-uploads"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY="<r2-access-key-id>"
STORAGE_SECRET_KEY="<r2-secret-access-key>"
# No trailing slash.
STORAGE_PUBLIC_URL_BASE="https://pub-<hash>.r2.dev"

# 20 MB per object. Presign refuses anything larger.
STORAGE_MAX_UPLOAD_BYTES=20971520
